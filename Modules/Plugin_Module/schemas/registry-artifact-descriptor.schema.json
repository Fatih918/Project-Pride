{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pride:registry-artifact-descriptor:1",
  "title": "PRIDE Registry Artifact Descriptor",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "plugin_id",
    "version",
    "release_id",
    "download_uri",
    "media_type",
    "size_bytes",
    "digest",
    "signature",
    "platform_metadata"
  ],
  "properties": {
    "$schema": {
      "const": "urn:pride:registry-artifact-descriptor:1"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "plugin_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "download_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "media_type": {
      "const": "application/vnd.pride.plugin+zip"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "value": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "additionalProperties": false
    },
    "platform_metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "plugin_type",
        "capabilities",
        "permission_ids",
        "compatibility_status"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "plugin_type": {
          "enum": [
            "active",
            "passive"
          ]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "additionalProperties": false
          }
        },
        "permission_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "compatibility_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$comment": "Schema 1.1.0 requires Marketplace-owned platform metadata covered by the detached Ed25519 descriptor signature. Duplicate JSON object keys must be rejected by implementations."
}
