{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pride:plugin-trust-configuration:1",
  "title": "PRIDE Plugin Trust Configuration",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "sequence",
    "issued_at",
    "expires_at",
    "keys",
    "signature"
  ],
  "properties": {
    "$schema": {
      "const": "urn:pride:plugin-trust-configuration:1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "algorithm",
          "public_key",
          "valid_from",
          "valid_until",
          "status"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$",
            "contentEncoding": "base64"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "active",
              "revoked"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "contentEncoding": "base64"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
