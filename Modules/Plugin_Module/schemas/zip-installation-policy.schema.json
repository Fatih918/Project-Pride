{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pride:plugin-zip-installation-policy:1",
  "title": "PRIDE Plugin ZIP Installation Policy",
  "description": "Versioned resource limits for inspecting and extracting PRIDE Plugin ZIP packages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "policy_id", "package_format", "limits"],
  "properties": {
    "$schema": {
      "const": "urn:pride:plugin-zip-installation-policy:1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "const": "pride.plugin.zip-installation"
    },
    "package_format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_format", "media_type"],
      "properties": {
        "archive_format": { "const": "zip" },
        "media_type": { "const": "application/vnd.pride.plugin+zip" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_compressed_archive_bytes",
        "max_total_expanded_bytes",
        "max_single_file_bytes",
        "max_entry_count",
        "max_directory_depth",
        "max_compression_ratio",
        "max_path_length_bytes",
        "max_metadata_allocation_bytes"
      ],
      "properties": {
        "max_compressed_archive_bytes": { "const": 104857600 },
        "max_total_expanded_bytes": { "const": 536870912 },
        "max_single_file_bytes": { "const": 134217728 },
        "max_entry_count": { "const": 10000 },
        "max_directory_depth": { "const": 32 },
        "max_compression_ratio": { "const": 100 },
        "max_path_length_bytes": { "const": 240 },
        "max_metadata_allocation_bytes": { "const": 16777216 }
      }
    }
  }
}
