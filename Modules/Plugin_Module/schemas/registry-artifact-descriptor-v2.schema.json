{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "plugin_id",
    "version",
    "release_id",
    "download_uri",
    "media_type",
    "size_bytes",
    "digest",
    "signature",
    "platform_metadata"
  ],
  "properties": {
    "$schema": {
      "const": "urn:pride:registry-artifact-descriptor:2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "plugin_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "download_uri": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048
    },
    "media_type": {
      "const": "application/vnd.pride.plugin+zip"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 104857600
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "platform_metadata": {
      "$ref": "#/$defs/platformMetadata"
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "value": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88
        }
      },
      "additionalProperties": false
    },
    "platformMetadata": {
      "$ref": "#/$defs/platformMetadataInline"
    },
    "platformMetadataInline": {
      "type": "object",
      "required": [
        "$schema",
        "schema_version",
        "plugin_type",
        "capabilities",
        "permission_ids",
        "compatibility_status"
      ],
      "properties": {
        "$schema": {
          "const": "urn:pride:platform-metadata:2"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "plugin_type": {
          "enum": [
            "active",
            "passive"
          ]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/capabilityDeclaration"
          }
        },
        "permission_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "compatibility_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "capabilityDeclaration": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "contract_version",
        "invocation_mode",
        "input_schema_ref",
        "output_schema_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "contract_version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64
        },
        "invocation_mode": {
          "const": "io.pride.invocation/request-response"
        },
        "input_schema_ref": {
          "type": "string",
          "minLength": 9,
          "maxLength": 240
        },
        "output_schema_ref": {
          "type": "string",
          "minLength": 9,
          "maxLength": 240
        },
        "platform_compatibility": {
          "$ref": "#/$defs/platformCompatibility"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      },
      "additionalProperties": false
    },
    "platformCompatibility": {
      "type": "object",
      "properties": {
        "pride_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime_profile_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "pride_version"
          ]
        },
        {
          "required": [
            "runtime_profile_ids"
          ]
        }
      ],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": [
        "capability_id",
        "version_requirement",
        "kind"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "version_requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "required",
            "optional"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
